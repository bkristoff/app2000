# Kopier denne filen til .env og fyll inn egne verdier. .env skal ikke inn i Git.
# Lag en tilfeldig hemmelighet med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=bytt-meg-ut-med-en-lang-tilfeldig-streng
CLIENT_URL=http://localhost:5173

# Lokal MySQL-database
DB_HOST=localhost
DB_PORT=3306
DB_USER=butikkapp
DB_PASSWORD=hemmelig
DB_NAME=butikk

# Alternativt: hele oppkoblingen i én URL (slik Heroku/JawsDB gjør det).
# Er JAWSDB_URL eller DATABASE_URL satt, blir DB_-variablene over ignorert.
# JAWSDB_URL=mysql://bruker:passord@vert:3306/database

# På Heroku settes PORT og NODE_ENV=production automatisk. Ikke sett dem her.
